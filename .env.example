# Copy to .env and fill in. NEVER commit .env. Sandbox credentials only.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=
ALLOW_LIVE=0

# Any OpenAI-compatible chat API. Free options:
#   Google Gemini (AI Studio key): https://generativelanguage.googleapis.com/v1beta/openai/
#   Groq (console key):            https://api.groq.com/openai/v1
# LLM_MODEL: copy a current free model id from AI Studio / the Groq console.
# Without these, every refund the rules would approve is HELD (fail closed).
# The demo agent (python -m demo_agent.orchestrator) uses the same model and needs tool calling.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=

WARDLOCK_SERVICE_KEY=
WARDLOCK_ADMIN_PASSWORD=
# 1 = anyone may open the console read-only ("View the live demo"); approve/deny still need the password.
CONSOLE_PUBLIC_READONLY=0
DATABASE_URL=sqlite:///./wardlock.db
# MCP endpoint DNS-rebinding protection (JSON lists). The defaults allow localhost only.
# MCP_ALLOWED_HOSTS=["localhost:*","127.0.0.1:*","wardlock.onrender.com"]
# MCP_ALLOWED_ORIGINS=["http://localhost:*","https://wardlock.onrender.com"]

# Refund limits (auto-approve limit, per-session cap, goodwill %) live only in policy.yaml.
SESSION_TTL_MINUTES=30
HOLD_TIMEOUT_MINUTES=15
